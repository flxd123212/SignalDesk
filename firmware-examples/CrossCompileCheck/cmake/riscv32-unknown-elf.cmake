set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER riscv32-unknown-elf-gcc CACHE FILEPATH "RISC-V C compiler")
set(CMAKE_CXX_COMPILER riscv32-unknown-elf-g++ CACHE FILEPATH "RISC-V C++ compiler")
set(CMAKE_C_FLAGS_INIT "-march=rv32imac -mabi=ilp32")

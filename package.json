{
  "name": "signaldesk",
  "version": "0.1.12",
  "description": "SignalDesk embedded development and instrumentation workbench",
  "homepage": "https://github.com/flxd123212/SignalDesk",
  "author": "SignalDesk",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "bin": {
    "signaldesk": "server/external/cli.mjs"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "serve": "node server/index.mjs",
    "start": "node desktop/start.mjs",
    "cli": "node server/external/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/create-app-icon.ps1",
    "package:win": "node tools/check-platform.mjs win32 && npm run build && electron-builder --win --x64 --publish never",
    "package:linux": "node tools/check-platform.mjs linux && npm run build && electron-builder --linux --publish never",
    "package:mac": "node tools/check-platform.mjs darwin && npm run build && electron-builder --mac --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test:platform": "node --test tests/platform.test.mjs",
    "test:platform-desktop": "node tests/platform-desktop.mjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "test:agent-restart": "node tests/agent-desktop-storage.mjs",
    "test:appearance": "node tests/appearance-desktop.mjs",
    "test:package": "node tests/package-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.6.0",
    "csv-parse": "^7.0.3",
    "diff": "^9.0.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.12.1",
    "fft.js": "^4.0.4",
    "iconv-lite": "^0.7.3",
    "ini": "^6.0.0",
    "jsep": "^1.4.0",
    "lucide-react": "^0.468.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serialport": "^13.0.0",
    "string-argv": "^0.4.0",
    "three": "^0.187.0",
    "uplot": "^1.6.31",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
